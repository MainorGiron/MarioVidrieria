# Copia este archivo como .env.local y llena los valores.
# Si dejas vacías las variables de Supabase, el sitio guarda todo en la carpeta /data (modo local).

# --- Supabase (Project Settings → API Keys / Data API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta: SOLO para "npm run migrar". Nunca la publiques ni la pongas en Vercel.
SUPABASE_SECRET_KEY=

# --- Modo local (solo se usa si NO configuras Supabase) ---
ADMIN_PASSWORD=indurocer
SESSION_SECRET=

# URL pública del sitio (para las vistas previas al compartir en redes).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
