# Copia este archivo como .env.local y cambia los valores.

# Contraseña para entrar a /admin (obligatoria en producción).
ADMIN_PASSWORD=cambia-esta-contrasena

# Texto largo y aleatorio para firmar la sesión del panel (opcional pero recomendado).
SESSION_SECRET=

# URL pública del sitio (para las vistas previas al compartir en redes).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
